# API-Tennis
API_TENNIS_API_KEY=your_api_tennis_api_key
API_TENNIS_BASE_URL=https://api.api-tennis.com/tennis/

# Email destination and sender
EMAIL_TO=your.email@example.com
EMAIL_FROM=tennis-digest@example.com

# SMTP account
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true

# Digest behavior
TIMEZONE=UTC
LOOKAHEAD_DAYS=7
API_TIMEOUT_SECONDS=30
# Logging
LOG_LEVEL=INFO
LOG_FILE=atp_digest.log
